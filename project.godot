; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LevelUpJam"
run/main_scene="uid://1ii02qh8q237"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GlobalAudioPlayer="*res://Script/GlobalAudioPlayer.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="viewport"
window/handheld/orientation=1
mouse_cursor/custom_image="uid://cdmb2er64lvkl"

[editor_plugins]

enabled=PackedStringArray("res://addons/nodetunnel/plugin.cfg")

[global_group]

Card=""
Slot=""
option=""

[rendering]

textures/canvas_textures/default_texture_filter=3
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
