[sub_resource type="GDScript" id="GDScript_a1b81"]
resource_name = "FirstTurn"
script/source = "extends PanelContainer

func first_turn_name(player_name : String):
	$FirstTurnLabel.text = \"[b][center]\" + player_name + \"\\n Goes first!\"

func enemy_first_turn():
	$FirstTurnLabel.text = \"[b][center] Opponent Goes first!\"
"

